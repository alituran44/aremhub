{
  "name": "AremHub Auto-Boost Viral Post to Meta Ads Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "viral-boost-webhook",
        "options": {}
      },
      "name": "Postiz Engagement Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.body.engagementRate }}",
              "operation": "largerEqual",
              "value2": 3.0
            }
          ]
        }
      },
      "name": "Is Engagement Rate > 3x?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "https://graph.facebook.com/v19.0/act_AREMHUB_ADS_ACCOUNT/campaigns",
        "options": {},
        "bodyParametersUi": {
          "parameter": [
            { "name": "name", "value": "=⚡ Auto-Boost: {{ $json.body.postTitle }}" },
            { "name": "objective", "value": "OUTCOME_ENGAGEMENT" },
            { "name": "status", "value": "ACTIVE" },
            { "name": "special_ad_categories", "value": "[]" }
          ]
        }
      },
      "name": "Launch Meta Ads Campaign",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [720, 200]
    },
    {
      "parameters": {
        "text": "=🚀 *AremHub Auto-Boost Tetiklendi!*\n\n*Gönderi:* {{ $json.body.postTitle }}\n*Etkileşim Oranı:* %{{ $json.body.engagementRate }}\n*Meta Ads Bütçesi:* ₺250/gün yayında!",
        "channel": "#reklam-otomasyon-uyarıları"
      },
      "name": "Send Slack/WhatsApp Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [950, 200]
    }
  ],
  "connections": {
    "Postiz Engagement Webhook": {
      "main": [[{ "node": "Is Engagement Rate > 3x?", "type": "main", "index": 0 }]]
    },
    "Is Engagement Rate > 3x?": {
      "main": [[{ "node": "Launch Meta Ads Campaign", "type": "main", "index": 0 }]]
    },
    "Launch Meta Ads Campaign": {
      "main": [[{ "node": "Send Slack/WhatsApp Alert", "type": "main", "index": 0 }]]
    }
  }
}
